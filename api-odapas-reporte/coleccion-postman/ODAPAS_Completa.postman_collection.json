        {
          "name": "Registrar ciudadano",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/registro",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "En modo demostración la respuesta trae enlaceDemo con el enlace que llegaría por correo.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Postman\",\n  \"email\": \"ana.{{$timestamp}}@example.test\",\n  \"password\": \"ClaveSegura2026\",\n  \"telefono\": \"5512345678\",\n  \"coloniaId\": {{coloniaId}},\n  \"calle\": \"Hidalgo\",\n  \"numeroExterior\": \"12\",\n  \"codigoPostal\": \"55000\",\n  \"terms\": true,\n  \"privacy\": true,\n  \"version\": \"{{version}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenCiudadano\", r.token);",
                  "pm.collectionVariables.set(\"correoCiudadano\", r.user.email);",
                  "pm.collectionVariables.set(\"tokenVerificacion\", pm.response.json().verificacion.enlaceDemo.split(\"token=\")[1]);"
                ]
              }
            }
          ]
        },
